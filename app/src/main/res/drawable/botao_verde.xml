<selector xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Quando pressionado -->
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="#2E7D32" /> <!-- Verde escuro ao clicar -->
            <corners android:radius="12dp" />
        </shape>
    </item>

    <!-- Estado normal -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#4CAF50" /> <!-- Verde principal -->
            <corners android:radius="12dp" />
            <stroke
                android:width="2dp"
                android:color="#388E3C" /> <!-- Borda verde escura -->
        </shape>
    </item>

</selector>
